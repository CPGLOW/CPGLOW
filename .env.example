# Configuración de CP GLOW
# Número de WhatsApp para recibir pedidos (con código de país, sin espacios ni símbolos)
# Ejemplo para Colombia: 573008318310
VITE_WHATSAPP_PHONE=573008318310

# Nombre y Slogan de la tienda
VITE_STORE_NAME=CP GLOW
